# Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
# Aucune de ces variables n'est secrète (elles finissent dans le bundle client),
# mais elles ne doivent pas être écrites en dur dans le code.

# Domaine public du site — utilisé pour les balises canoniques et Open Graph.
VITE_SITE_URL=https://codeqrgen.fr

# Publisher ID AdSense (AdSense > Compte > Informations sur le compte).
# Tant que cette variable est vide, AUCUN script publicitaire n'est chargé et les
# blocs <AdUnit> ne rendent rien : c'est le mode à conserver tant que le compte
# n'est pas approuvé par Google.
VITE_ADSENSE_CLIENT_ID=

# Identifiants des blocs créés dans AdSense > Annonces > Par bloc d'annonces.
# Un slot laissé vide désactive proprement l'emplacement correspondant.
VITE_AD_SLOT_HEADER=
VITE_AD_SLOT_AFTER_GENERATOR=
VITE_AD_SLOT_IN_ARTICLE=
VITE_AD_SLOT_FOOTER=
VITE_AD_SLOT_SIDEBAR=
VITE_AD_SLOT_MOBILE_ANCHOR=
