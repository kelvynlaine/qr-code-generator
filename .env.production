# Variables publiques du site en production.
#
# Elles sont volontairement versionnées : ce ne sont pas des secrets (elles
# apparaissent en clair dans le code source des pages), et sans elles un build
# fait depuis un clone du dépôt repart en mode neutre, sans publicité.
# Les vraies valeurs sensibles n'ont pas leur place ici.

VITE_SITE_URL=https://codeqrgen.fr
VITE_ADSENSE_CLIENT_ID=ca-pub-2244677473979299

# Blocs manuels : laisser sur false tant qu'AdSense n'a pas approuvé le site.
# Après approbation, passer à true puis reconstruire et redéployer.
VITE_ADSENSE_SHOW_UNITS=false

VITE_AD_SLOT_AFTER_GENERATOR=5433820303
VITE_AD_SLOT_IN_ARTICLE=9542641610
