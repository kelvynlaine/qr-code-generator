# Configuration Apache / LiteSpeed (Hostinger) — copiée à la racine du build par Vite.

# MultiViews associerait /guides/x à guides.html : désactivé pour des URL sans ambiguïté.
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (requis par AdSense, et par le référencement).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Une seule adresse par page : /index.html → / et /faq.html → /faq.
  # THE_REQUEST ne concerne que la requête d'origine, ce qui évite toute boucle
  # avec la réécriture interne ci-dessous.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]

  # Anciennes adresses du site (version précédente, encore indexées par Google) :
  # redirection permanente vers la page équivalente, plutôt qu'une erreur 404.
  RewriteRule ^a-propos/?$ /contact [R=301,L]
  RewriteRule ^confidentialite/?$ /politique-de-confidentialite [R=301,L]
  RewriteRule ^conditions/?$ /conditions-utilisation [R=301,L]
  RewriteRule ^guides/creer-un-qr-code-personnalise/?$ /guide/personnaliser-qr-code-sans-perdre-la-lecture [R=301,L]
  RewriteRule ^guides/qr-code-statique-vs-dynamique/?$ /guide/qr-code-statique-ou-dynamique [R=301,L]
  RewriteRule ^guides/qr-code-vcard-contact/?$ /guide/qr-code-carte-de-visite [R=301,L]
  RewriteRule ^guides/(qr-code-wifi|qr-code-menu-restaurant|niveau-correction-erreur-qr-code|qr-code-carte-de-visite|qr-code-reseaux-sociaux)/?$ /guide/$1 [R=301,L]
  RewriteRule ^guides/.+$ /guides [R=301,L]

  # Une seule adresse par page : /faq/ → /faq.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Chaque page est pré-générée en HTML : /faq sert faq.html, /guide/x sert guide/x.html.
  # Les fichiers réels (assets, ads.txt, robots.txt, sitemap.xml) restent servis tels quels.
  # Le test porte sur le chemin exact ($1.html) : avec REQUEST_FILENAME, une adresse comme
  # /guides/x pouvait être résolue en guides.html + « /x », d'où une boucle et une erreur 500.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Adresse inexistante : vraie erreur 404, avec une page utile. Renvoyer la page
# d'accueil avec un code 200 créerait des « soft 404 » pénalisés par Google.
ErrorDocument 404 /404.html

# Compression : divise par ~4 le poids du JS et du CSS transférés.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache : les assets générés par Vite portent un hash dans leur nom, ils peuvent
# être mis en cache indéfiniment. Les pages HTML et les fichiers de vérification
# ne doivent jamais l'être, sous peine de servir une version périmée du site.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

<FilesMatch "\.(html|txt|xml)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Le crawler AdSense doit pouvoir lire ce fichier sans redirection.
<Files "ads.txt">
  Header set Cache-Control "public, max-age=3600"
</Files>
